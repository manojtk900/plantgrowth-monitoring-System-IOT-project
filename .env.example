# =====================================================================
# IoT Plant Growth & Environmental Monitoring System
# Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Copy this file to '.env' for local configuration.
# - NEVER commit actual secrets, passwords, or tokens to version control.
# =====================================================================

# Flask Server Configuration
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production

# Database Connection URI
# Local Development (SQLite default):
# DATABASE_URL=sqlite:///database/plant_monitor.db
#
# Production Cloud (Render Managed PostgreSQL or Supabase):
DATABASE_URL=postgresql://username:password@hostname:5432/databasename?sslmode=require

# Edge Hardware Identification
PRIMARY_DEVICE_ID=ESP32_003
